---
import Base from '../layouts/Base.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { getContent } from '../lib/content.js';

const c = getContent();
const categories = [...new Set(c.photos.map((p) => p.category))];
---

<Base current="Photos" title="Photos" description={`Portraits et photographies de scène de ${c.site.name}.`}>
  <article class="section wrap">
    <h1 class="title">Photos</h1>

    {
      categories.map((cat) => (
        <section class="cat">
          <h2 class="eyebrow">{cat}</h2>
          <PhotoGrid photos={c.photos.filter((p) => p.category === cat)} />
        </section>
      ))
    }
  </article>
</Base>

<style>
  .title {
    font-size: clamp(34px, 6vw, 56px);
    line-height: 1.05;
    text-transform: uppercase;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .cat {
    margin-top: clamp(40px, 6vw, 64px);
  }

  .cat h2 {
    padding-bottom: 12px;
    margin-bottom: clamp(24px, 4vw, 40px);
    border-bottom: 1px solid var(--rule);
  }
</style>
