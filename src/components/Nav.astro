---
import { getContent } from '../lib/content.js';

const c = getContent();

// Pages réellement construites : un lien vers une page qui n'existe pas
// encore est un lien mort, et l'aperçu en montrerait plusieurs.
const built = new Set(
  Object.keys(import.meta.glob('../pages/*.astro')).map((f) =>
    f.split('/').pop().replace('.astro', ''),
  ),
);

// Une rubrique sans contenu disparaît du menu — spec, section Arborescence.
const links = [
  { href: 'parcours.html', label: 'Parcours', show: c.bio.length > 0 || c.cv.length > 0 },
  { href: 'photos.html', label: 'Photos', show: c.photos.length > 0 },
  { href: 'videos.html', label: 'Vidéos', show: c.videos.length > 0 },
  { href: 'agenda.html', label: 'Agenda', show: c.dates.length > 0 },
  { href: 'ateliers.html', label: 'Ateliers', show: c.ateliers.length > 0 },
  { href: 'presse.html', label: 'Presse', show: c.press.length > 0 },
  { href: 'contact.html', label: 'Contact', show: true },
].filter((l) => l.show && built.has(l.href.replace('.html', '')));

const { current } = Astro.props;
---

<header class="nav wrap">
  <a class="nav__name" href="index.html">{getContent().site.name}</a>
  <nav aria-label="Navigation principale">
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={current === l.label ? 'page' : undefined}>{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    align-items: center;
    justify-content: space-between;
    padding-block: 26px;
  }

  .nav__name {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-decoration: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    color: var(--ink-quiet);
  }
</style>
